{
  "name": "beeper-zalo-bridge",
  "version": "1.0.0",
  "description": "Self-hosted Beeper-Zalo Matrix bridge (zca-js + matrix-appservice-bridge)",
  "scripts": {
    "spike:login": "node spike/zalo-login-and-listen.ts",
    "spike:send": "node spike/zalo-relogin-and-send.ts",
    "dev": "node src/index.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "zalo",
    "beeper",
    "matrix",
    "bridge",
    "appservice",
    "zca-js"
  ],
  "author": "Le Thuc Thanh Tu (https://github.com/lethucthanhtu)",
  "contributors": [
    "lequocbinh04 (https://github.com/lequocbinh04)"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lethucthanhtu/zalo-beeper-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/lethucthanhtu/zalo-beeper-bridge/issues"
  },
  "homepage": "https://github.com/lethucthanhtu/zalo-beeper-bridge#readme",
  "engines": {
    "node": ">=22.18.0"
  },
  "type": "module",
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "image-size": "2.0.4",
    "js-yaml": "5.5.0",
    "matrix-appservice-bridge": "12.0.1",
    "wasm-webp": "0.1.0",
    "zca-js": "2.1.2",
    "zod": "4.6.7"
  },
  "private": true,
  "devDependencies": {
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/jxl": "1.3.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.1.0",
    "eslint": "10.6.0",
    "eslint-config-prettier": "9.1.2",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vitest": "4.1.12"
  }
}
