<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Beeper<->Zalo bridge appservice.
  Install: copy to ~/Library/LaunchAgents/ and `launchctl load` it (see docs/deployment-guide.md).
  Paths are absolute because launchd runs with a minimal environment.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.beeper-zalo.bridge</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/YOUR_USER/.nvm/versions/node/vXX/bin/node</string>
        <string>src/index.ts</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/YOUR_USER/zalo-beeper-bridge</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/YOUR_USER/.nvm/versions/node/vXX/bin:/usr/bin:/bin:/usr/local/bin:/opt/homebrew/bin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/Users/YOUR_USER/zalo-beeper-bridge/logs/bridge.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USER/zalo-beeper-bridge/logs/bridge.log</string>
</dict>
</plist>
